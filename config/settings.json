{
  "agents": [
    {
      "id": "claude",
      "name": "Claude Code",
      "command": "claude",
      "args": [
        "-p",
        "--permission-mode",
        "acceptEdits",
        "{prompt}"
      ],
      "inputMode": "argument",
      "enabled": true
    },
    {
      "id": "codex",
      "name": "Codex",
      "command": "codex",
      "args": [
        "exec",
        "--sandbox",
        "workspace-write",
        "{prompt}"
      ],
      "inputMode": "argument",
      "enabled": true
    }
  ],
  "notifications": {
    "telegram": {
      "enabled": false,
      "botToken": "",
      "chatId": ""
    }
  }
}
