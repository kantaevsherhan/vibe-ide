{
  "server": {
    "host": "0.0.0.0",
    "port": 8080
  },
  "auth": {
    "enabled": true,
    "username": "admin",
    "password": "change-me",
    "email": "admin@example.com",
    "sessionSecret": "change-this-secret"
  },
  "workspace": {
    "path": "workspace",
    "maxFolderChildren": 500
  },
  "security": {
    "allowTerminal": true,
    "allowGit": true,
    "maxFileSizeMb": 5,
    "allowedOrigins": ["*"]
  },
  "ignore": {
    "enabled": true,
    "useDefaultRules": true,
    "vibeIgnoreFile": ".vibeignore"
  }
}
